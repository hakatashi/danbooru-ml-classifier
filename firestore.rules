rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access only to hakatasiloving@gmail.com
    match /images/{imageId} {
      allow read: if request.auth != null && request.auth.token.email == 'hakatasiloving@gmail.com';
      allow write: if false;
    }

    // Legacy favorites collection — read-only. Favorites now live in MongoDB
    // (images.favorites, written via worker/api.py's authenticated
    // /favorites/* endpoints). This collection is kept read-only, not
    // deleted, so the MongoDB migration in publisher/scripts/
    // migrate-favorites-to-mongo.ts remains reversible.
    match /favorites/{imageId} {
      allow read: if request.auth != null && request.auth.token.email == 'hakatasiloving@gmail.com';
      allow create, update, delete: if false;
    }

    // Allow read access to moderationStats for authenticated users
    match /moderationStats/{document=**} {
      allow read: if request.auth != null && request.auth.token.email == 'hakatasiloving@gmail.com';
      allow write: if false;
    }

    // Allow read access to generated_novels for authenticated user
    match /generated_novels/{novelId} {
      allow read: if request.auth != null && request.auth.token.email == 'hakatasiloving@gmail.com';
      allow create, update, delete: if false;
    }

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}